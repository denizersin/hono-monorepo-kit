{
    "compilerOptions": {

        "strict": true,
        "noUncheckedIndexedAccess": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "moduleResolution": "bundler",
        "target": "ES2022",
        "module": "ESNext",
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "allowSyntheticDefaultImports": true
    },
    "exclude": [
        "node_modules",
        "dist",
        "build",
        "**/*.test.ts",
        "**/*.spec.ts"
    ]
}
