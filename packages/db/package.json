{
  "name": "@repo/db",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./schema": "./dist/schema.js",
    ".": "./dist/index.js"
  },
  "scripts": {
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "dev": "tsc --watch",
    "build": "tsc",
    "db:dump": "tsx ./src/modules/infrastructure/database/scripts/db-dump.ts",
    "db:backup": "tsx ./src/modules/infrastructure/database/scripts/db-backup.ts",
    "db:studio": "bunx drizzle-kit studio --config ../../packages/db/drizzle.config.ts",
    "initialize-db": "tsx ./src/modules/infrastructure/database/scripts/initialize-db.ts",
    "initialize-new-look-up": "tsx ./src/modules/infrastructure/database/scripts/initialize-new-look-up.ts",
    "reset-db-step1": "tsx ./src/modules/infrastructure/database/scripts/re-create-db.ts",
    "reset-db-step2": "rm -rf ./migrations && bun run update-db ",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "update-db": "bun run db:generate && sleep 1 && bun run db:migrate",
    "drizzle-studio": "npx drizzle-kit studio"
  },
  "dependencies": {
    "@repo/config": "workspace:*",
    "@repo/shared": "workspace:*",
    "drizzle-orm": "^0.44.5",
    "pg": "^8.16.3"
  },
  "peerDependencies": {
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "@types/react-dom": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.4",
    "typescript": "^5.9.2"
  }
}