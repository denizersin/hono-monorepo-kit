{
  "name": "@repo/jobs",
  "version": "1.0.0",
  "description": "Background job processing with BullMQ and Redis",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc --build",
    "type-check": "tsc --noEmit",
    "start-workers": "bun run ./src/start.ts"
  },
  "keywords": [
    "bull",
    "redis",
    "queue",
    "jobs",
    "background-jobs"
  ],
  "dependencies": {
    "@repo/config": "workspace:*",
    "@repo/email": "workspace:*",
    "@repo/logger": "workspace:*",
    "@repo/shared": "workspace:*",
    "@types/nodemailer": "^7.0.11",
    "bullmq": "^5.71.0",
    "nodemailer": "^8.0.1",
    "redis": "^4.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bull": "^4.10.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.9.2",
    "ts-node": "^10.9.0"
  }
}