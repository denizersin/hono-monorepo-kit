# Environment
NODE_ENV=development

# Backend
PORT=3002

# Database
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5433/turborepo
DATABASE_NAME=turborepo

# Web URL (for CORS)
WEB_URL=http://localhost:3000

# Auth
JWT_SECRET=your-jwt-secret-here

# Admin credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-admin-password

# WordPress client
WP_CLIENT_API_KEY=your-api-key
WP_CLIENT_URL=http://localhost:3113

# Redis (for jobs/backend)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
BULL_BOARD_BASE_PATH=bull-ui

# Web/Next.js
NEXT_PUBLIC_API_URL=http://localhost:3002
NEXT_PUBLIC_WS_URL=http://localhost:3002/websocket

# Mobile
API_URL=http://localhost:3002
WS_URL=http://localhost:3002/websocket
