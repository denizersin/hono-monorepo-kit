# Backend Environment Variables
NODE_ENV=development
PORT=3002

# Database
DATABASE_URL_DEV=postgresql://postgres:password@127.0.0.1:5433/turborepo
DATABASE_URL_PROD=postgresql://postgres:password@127.0.0.1:5433/turborepo
DATABASE_NAME=turborepo

# Web URLs
WEB_DEV_URL=http://localhost:3000
WEB_PROD_URL=https://your-domain.com

# Auth
JWT_SECRET=your-jwt-secret-here

# Admin credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-admin-password

# WordPress client
WP_CLIENT_API_KEY=your-api-key
WP_CLIENT_URL=http://localhost:3113

# Web/Mobile Environment Variables
NEXT_PUBLIC_API_URL_DEV=http://localhost:3002
NEXT_PUBLIC_API_URL_PROD=https://your-api-domain.com
NEXT_PUBLIC_WS_URL_DEV=http://localhost:3002/websocket
NEXT_PUBLIC_WS_URL_PROD=https://your-api-domain.com/websocket

# Mobile specific
API_URL_DEV=http://localhost:3002
API_URL_PROD=https://your-api-domain.com
WS_URL_DEV=http://localhost:3002/websocket
WS_URL_PROD=https://your-api-domain.com/websocket
